{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/logos-boundary-literature/schemas/boundary_claim.schema.json",
  "title": "BoundaryClaim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "work_id",
    "claim_type",
    "assertion_mode",
    "canonical_claim",
    "review_status",
    "confidence",
    "evidence_refs"
  ],
  "properties": {
    "claim_id": { "type": "string" },
    "work_id": { "type": "string" },
    "claim_type": { "type": "string" },
    "target_scripture_ref": { "type": ["string", "null"] },
    "claim_text_summary": { "type": ["string", "null"] },
    "assertion_mode": {
      "type": "string",
      "enum": [
        "direct_source_claim",
        "reception_claim",
        "scholarly_claim",
        "heterodox_claim",
        "refutation_target",
        "disputed_claim"
      ]
    },
    "canonical_claim": { "type": "boolean", "const": false },
    "tradition_scope": { "type": ["string", "array", "null"], "items": { "type": "string" } },
    "profile_scope": { "type": ["string", "array", "null"], "items": { "type": "string" } },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "review_status": {
      "type": "string",
      "enum": ["draft", "requires_human_review", "reviewed", "quarantine_unreviewed"]
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high", "unknown"]
    },
    "notes": { "type": ["string", "null"] }
  }
}
